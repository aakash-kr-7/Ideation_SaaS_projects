# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only Supabase secrets — NEVER add NEXT_PUBLIC_ prefix
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Worker dispatch authentication
WEBHOOK_SECRET=

# Edge Function secrets — set via supabase secrets, not here
# GEMINI_API_KEY is Edge Function-only; see supabase/functions/.env.production.example

# Optional: per-run cost cap override (USD)
RESEARCH_RUN_COST_CAP_USD=

# Local Supabase Auth — Google OAuth (set in root .env for Supabase CLI)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Deployment identity — controls security header profiles
# Values: "production", "staging", or omit for local development
# SHOULDBUILD_DEPLOYMENT_ENV=

# Future: Dodo Payments (not yet implemented)
# PAYMENTS_PROVIDER=
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_ENVIRONMENT=
